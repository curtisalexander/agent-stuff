{
  "name": "agent-stuff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "keywords": ["pi-package"],
  "files": [
    "extensions",
    "scripts",
    "skills",
    "README.md"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "pi": "npx -y node@22.19.0 ./node_modules/@earendil-works/pi-coding-agent/dist/bundle/cli.js",
    "setup:powershell": "bash scripts/install-powershell-linux.sh",
    "test:powershell": "npx -y node@22.19.0 scripts/test-powershell-extension.mjs",
    "test:powershell:model": "npx -y node@22.19.0 scripts/test-powershell-model.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "ws": "^8.20.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "typebox": "~1.3.7"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@types/node": "^22.0.0",
    "jiti": "2.7.0",
    "typebox": "1.3.7",
    "typescript": "^5.9.0"
  },
  "pi": {
    "extensions": ["./extensions"],
    "skills": ["./skills"]
